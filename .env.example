# AcademicAI Environment Variables Template
# Copy this file to .env.local for local development. Do not commit actual secrets to version control.

# Database connection (SQLite for Milestone 1, easily configurable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Application runtime environment
NODE_ENV="development"
PORT="3000"

# Future API integrations (Milestone 3+)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
