<!-- ==================== 8. IMPLEMENTATION ==================== -->
<h2>8. IMPLEMENTATION</h2>
<p>The application is implemented in TypeScript 5.7 and Next.js 15.2 with Prisma ORM 6.4 and SQLite 3. Client interfaces utilize React 19 and Lucide icons. OCR is powered by Tesseract.js 7.0 (WASM).</p>
<pre>
// Invariant Additive Priority Scoring (lib/intelligence/priority-engine.ts)
export function calculateAcademicPriority(input: PriorityEvaluationInput): PriorityEvaluationResult {
  let score = 15; // Base score for active deliverable
  const factors: PriorityFactor[] = [{ name: "Active Deliverable", points: 15, detail: "Base weight" }];
  if (input.deadline) {
    const diffHours = (input.deadline.getTime() - input.now.getTime()) / 3600000;
    if (diffHours &lt; 24) { score += 30; factors.push({ name: "Due &lt; 24h", points: 30 }); }
    else if (diffHours &lt; 48) { score += 20; factors.push({ name: "Due &lt; 48h", points: 20 }); }
    else if (diffHours &lt; 168) { score += 10; factors.push({ name: "Due this week", points: 10 }); }
    else { score += 5; factors.push({ name: "Distant deadline", points: 5 }); }
  }
  const level: PriorityLevel = score &gt;= 75 ? "CRITICAL" : score &gt;= 55 ? "HIGH" : score &gt;= 35 ? "MEDIUM" : "LOW";
  return { score: Math.min(score, 100), level, factors, explanation: generateExplanation(factors) };
}
</pre>

<!-- ==================== 9. EXPERIMENTAL SETUP ==================== -->
<h2>9. EXPERIMENTAL SETUP</h2>
<p><strong>Environment:</strong> Intel Core i7-12700H CPU @ 2.30 GHz, 16 GB DDR5 RAM, Windows 11 Enterprise, Node.js v22.13.4, CPU-only execution. Random seed: 42.<br>
<strong>Baselines:</strong> (1) Heuristic RegEx baseline, (2) Statistical TF-IDF + Multinomial Logistic Regression baseline.</p>

